# docker compose 가 읽는 설정 파일입니다. 복사해서 .env 로 저장한 뒤 값을 채우세요.
#   cp .env.example .env
# .env 는 비밀 정보라 git 에 올리지 않습니다 (.gitignore 에 포함).

# 로그인 비밀번호의 argon2 해시. 해시 안의 $ 가 변수로 해석되지 않도록 반드시 작은따옴표로 감싸세요.
# 해시 만들기: docker compose run --rm --no-deps app python -m app.cli hash-password
APP_PASSWORD_HASH='여기에-해시를-붙여넣으세요'

# 운영 compose 의 Caddy 가 인증서를 발급받을 도메인 (DuckDNS 무료 서브도메인 등)
DOMAIN=mytodo.duckdns.org

# 선택 설정 (기본값 그대로 써도 됩니다)
SESSION_DAYS=90
BACKUP_KEEP=14
TZ=Asia/Seoul
